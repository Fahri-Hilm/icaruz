{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ICARUZ",
  "version": "1.0.0",
  "identifier": "id.icaruz.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ICARUZ",
        "width": 1180,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
